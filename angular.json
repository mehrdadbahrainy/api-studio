{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "api-studio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [{"glob":"**/*","input":"src/assets","output":"assets"}],
            "styles": ["src/styles.scss"],
            "outputPath": "dist/api-studio"
          },
          "configurations": {
            "production": {"outputHashing":"all","budgets":[{"type":"initial","maximumWarning":"750kb","maximumError":"1.5mb"}]},
            "development": {"optimization":false,"sourceMap":true,"extractLicenses":false}
          },
          "defaultConfiguration": "production"
        },
        "serve": {"builder":"@angular/build:dev-server","configurations":{"development":{"buildTarget":"api-studio:build:development"}},"defaultConfiguration":"development"}
      }
    }
  }
}
